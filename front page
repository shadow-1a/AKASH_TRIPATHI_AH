    <script>
        // Initialize Map targeting central coordinate anchors in Prayagraj
        const map = L.map('map-container').setView([25.4358, 81.8463], 12);

        // Inject free OpenStreetMap mapping tiles layout structure
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 18,
            attribution: '&copy; <a href="https://openstreetmap.org">OpenStreetMap</a> contributors'
        }).addTo(map);

        // Core Destination Markers Array Data Definitions
        const touristSpots = [
            { name: "Triveni Sangam", lat: 25.4284, lng: 81.8860, info: "Sacred meeting point of holy rivers." },
            { name: "Akbar Fort", lat: 25.4294, lng: 81.8770, info: "Colossal Mughal fortress architecture built in 1583." },
            { name: "Anand Bhavan Museum", lat: 25.4605, lng: 81.8659, info: "Historic ancestral estate mansion of Nehru family." },
            { name: "Khusro Bagh", lat: 25.4412, lng: 81.8335, info: "Intricate sandstone burial tombs garden park." },
            { name: "Chandrashekhar Azad Park", lat: 25.4542, lng: 81.8542, info: "Historical space hosting freedom struggle relics." }
        ];

        // Map and render markers sequentially
        touristSpots.forEach(spot => {
            L.marker([spot.lat, spot.lng])
                .addTo(map)
                .bindPopup(`<b>${spot.name}</b><br><span style="font-size:12px;color:#555;">${spot.info}</span>`);
        });

        let userMarker, userCircle;

        // Device Live Geolocation Query Callback Utilities
        function locateUser() {
            if (!navigator.geolocation) {
                alert("Geolocation mapping features are not supported by your current browser environment.");
                return;
            }

            navigator.geolocation.getCurrentPosition(
                (position) => {
                    const lat = position.coords.latitude;
                    const lng = position.coords.longitude;

                    // Clean previous search marker instances
                    if (userMarker) {
                        map.removeLayer(userMarker);
                        map.removeLayer(userCircle);
                    }

