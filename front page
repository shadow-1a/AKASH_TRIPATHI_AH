<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prayagraj Tourism | The Sacred Confluence</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://jsdelivr.net"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Cinzel:wght@500;700;800&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cloudflare.com">
    
    <style>
        body {
            font-family: 'Poppins', sans-serif;
        }
        .heading-font {
            font-family: 'Cinzel', serif;
        }
        /* Custom parallax and overlay styles */
        .hero-bg {
            background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.6)), 
                              url('https://unsplash.com');
            background-size: cover;
            background-position: center;
        }
        .sangam-bg {
            background-image: linear-gradient(rgba(140, 50, 0, 0.85), rgba(40, 10, 0, 0.95)), 
                              url('https://unsplash.com');
            background-size: cover;
            background-position: center;
        }
        /* Smooth floating animation for elements */
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
            100% { transform: translateY(0px); }
        }
        .float-animation {
            animation: float 4s ease-in-out infinite;
        }
    </style>
</head>
<body class="bg-amber-50/30 text-stone-800 scroll-smooth">

    <!-- Navigation Bar -->
    <nav class="fixed w-full z-50 bg-white/80 backdrop-blur-md shadow-sm border-b border-amber-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">
                <div class="flex items-center gap-2">
                    <span class="heading-font text-2xl font-bold tracking-widest text-amber-700">PRAYAGRAJ</span>
                </div>
                <!-- Desktop Nav -->
                <div class="hidden md:flex items-center space-x-8 font-medium text-stone-600">
                    <a href="#home" class="hover:text-amber-600 transition-colors text-amber-700 font-semibold">Home</a>
                    <a href="#about" class="hover:text-amber-600 transition-colors">About</a>
                    <a href="#attractions" class="hover:text-amber-600 transition-colors">Attractions</a>
                    <a href="#kumbh" class="hover:text-amber-600 transition-colors">Kumbh Mela</a>
                    <a href="#contact" class="bg-amber-600 text-white px-5 py-2.5 rounded-full hover:bg-amber-700 transition-transform hover:scale-105 shadow-md">Plan Trip</a>
                </div>
                <!-- Mobile Menu Button -->
                <div class="md:hidden">
                    <button id="menu-btn" class="text-stone-700 focus:outline-none text-2xl">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                </div>
            </div>
        </div>
        <!-- Mobile Dropdown Menu -->
        <div id="mobile-menu" class="hidden md:hidden bg-white border-b border-amber-100 px-4 pt-2 pb-6 space-y-3">
            <a href="#home" class="block py-2 text-stone-700 hover:text-amber-600">Home</a>
            <a href="#about" class="block py-2 text-stone-700 hover:text-amber-600">About</a>
            <a href="#attractions" class="block py-2 text-stone-700 hover:text-amber-600">Attractions</a>
            <a href="#kumbh" class="block py-2 text-stone-700 hover:text-amber-600">Kumbh Mela</a>
            <a href="#contact" class="block text-center bg-amber-600 text-white py-2.5 rounded-full">Plan Trip</a>
        </div>
    </nav>

    <!-- Hero Section -->
    <header id="home" class="hero-bg h-screen flex items-center justify-center text-center relative px-4">
        <div class="max-w-4xl text-white space-y-6">
            <p class="text-amber-400 font-semibold tracking-widest uppercase text-sm sm:text-base md:tracking-[0.3em]">Experience the Divine Confluence</p>
            <h1 class="heading-font text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-wide drop-shadow-lg leading-tight">
                Mystic. Spiritual. <span class="text-amber-400">Historic.</span>
            </h1>
            <p class="text-lg sm:text-xl text-stone-200 max-w-2xl mx-auto font-light">
                Welcome to the city of timeless faith, architectural marvels, and the legendary Triveni Sangam.
            </p>
            <div class="pt-4">
                <a href="#about" class="inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-600 text-white font-semibold px-8 py-3.5 rounded-full shadow-lg transition-all transform hover:-translate-y-0.5">
                    Explore Now <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>
        <!-- Bottom wave decoration -->
        <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-[0]">
            <svg viewBox="0 0 1200 120" preserveAspectRatio="none" class="relative block w-full h-[60px] fill-amber-50/30">
                <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V120H0V0C26.9,3,57.05,10.9,86.51,20,165.7,44.78,247.19,70.21,321.39,56.44Z"></path>
            </svg>
        </div>
    </header>

    <!-- Overview Section -->
    <section id="about" class="py-20 px-4 max-w-7xl mx-auto">
        <div class="grid md:grid-cols-2 gap-12 items-center">
            <div class="space-y-6">
                <div class="inline-block bg-amber-100 text-amber-800 font-medium text-xs px-3 py-1 rounded-full uppercase tracking-wider">The Abode of Brahma</div>
                <h2 class="heading-font text-3xl sm:text-4xl font-bold text-stone-900">A Heritage Woven In Faith & Grandeur</h2>
                <p class="text-stone-600 leading-relaxed">
                    Situated at the sacred confluence of the Rivers Ganga, Yamuna, and the mythical Saraswati, Prayagraj stands as one of India's oldest and most spiritually vibrant cities. 
                </p>
                <p class="text-stone-600 leading-relaxed">
                    From hosting the spectacular mass pilgrimage of the Kumbh Mela to witnessing the crucial declarations of India's freedom struggle, this city blends profound devotion with monumental historical legacies.
                </p>
                <div class="grid grid-cols-3 gap-4 pt-4 text-center">
                    <div class="p-4 bg-white rounded-2xl shadow-xs border border-amber-100">
                        <i class="fa-solid fa-place-of-worship text-amber-600 text-2xl mb-2"></i>
                        <p class="font-bold text-stone-800">100+</p>
                        <p class="text-xs text-stone-500">Temples</p>
                    </div>
                    <div class="p-4 bg-white rounded-2xl shadow-xs border border-amber-100">
                        <i class="fa-solid fa-water text-sky-600 text-2xl mb-2"></i>
                        <p class="font-bold text-stone-800">3</p>
                        <p class="text-xs text-stone-500">Holy Rivers</p>
                    </div>
                    <div class="p-4 bg-white rounded-2xl shadow-xs border border-amber-100">
                        <i class="fa-solid fa-users text-orange-600 text-2xl mb-2"></i>
                        <p class="font-bold text-stone-800">Millions</p>
                        <p class="text-xs text-stone-500">Devotees</p>
                    </div>
                </div>
            </div>
            <div class="relative flex justify-center">
                <div class="w-72 h-96 sm:w-80 sm:h-[420px] rounded-3xl overflow-hidden shadow-2xl border-4 border-white transform -rotate-3 z-10">
                    <img src="https://unsplash.com" class="w-full h-full object-cover" alt="Prayagraj Temple Layout">
                </div>
                <div class="w-72 h-96 sm:w-80 sm:h-[420px] rounded-3xl overflow-hidden shadow-xl border-4 border-white transform rotate-6 absolute top-8 left-1/4 opacity-80 hidden sm:block -z-10">
                    <img src="https://unsplash.com" class="w-full h-full object-cover" alt="Ancient Ghats">
                </div>
            </div>
        </div>
    </section>

    <!-- Main Attractions Section -->
    <section id="attractions" class="py-20 bg-stone-900 text-white px-4">
        <div class="max-w-7xl mx-auto">
            <div class="text-center max-w-2xl mx-auto mb-16 space-y-4">
                <span class="text-amber-400 font-semibold tracking-wider text-sm uppercase">Destinations of Wonder</span>
                <h2 class="heading-font text-3xl sm:text-4xl font-bold">Must-Visit Experiences</h2>
                <div class="h-1 w-20 bg-amber-500 mx-auto rounded-full"></div>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
                <!-- Card 1 -->
                <div class="bg-stone-800/80 rounded-2xl overflow-hidden border border-stone-700 hover:border-amber-500/50 transition-all group shadow-lg">
                    <div class="h-64 overflow-hidden relative">
